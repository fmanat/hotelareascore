# StayContext — environment template
# Copy to .env (never commit .env). Secrets live ONLY in Cloudflare/GitHub
# secret stores (CLAUDE.md hard rule 8). RLS on any client-accessible table.

# ---- Site (docs/adr/012) ----
# The only place the production domain is defined outside web/src/lib/site.ts.
SITE_URL=https://staycontext.com

# ---- Supabase (serving DB) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# service-role key: server-side only, set as a deploy secret, NEVER here:
# SUPABASE_SERVICE_ROLE_KEY -> Cloudflare/GitHub secret store

# ---- Cloudflare ----
CF_ACCOUNT_ID=
CF_R2_BUCKET=hotelareascore-snapshots

# ---- Affiliate (Phase 5+, keys as deploy secrets) ----
# AFFILIATE_<PROVIDER>_KEY -> secret store

# ---- Feature flags (CLAUDE.md §8 — default OFF, flip deliberately) ----
PUBLIC_INDEXING_ENABLED=false
HOTEL_PAGE_INDEXING_ENABLED=false
AFFILIATE_ENABLED=false
AI_SUMMARIES_ENABLED=false
MISSING_HOTEL_GEOCODING_ENABLED=false
MAP_ENABLED=false
DATA_REFRESH_ENABLED=false
SEO_AUTOMATION_ENABLED=false
