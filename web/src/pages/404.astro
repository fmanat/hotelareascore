---
// Astro/Cloudflare Pages convention: 404.astro builds to 404.html, served
// automatically for any unmatched path. Deliberately no `indexable` prop
// (defaults false, BaseLayout.astro) -- a 404 must never be indexable,
// independent of any flag. Plain and honest: no fabricated "you might
// like" hotel suggestions (CLAUDE.md hard rule 3), just a way back to a
// real page.
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist. Search for a hotel or go back to the homepage.">
  <div class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lede">The link may be out of date, or the address was mistyped.</p>
    <SearchBox />
    <p class="back"><a href="/">← Back to the homepage</a></p>
  </div>
</BaseLayout>

<style>
  .not-found { padding: 40px 0 20px; max-width: 480px; }
  .code {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    margin: 0 0 8px;
  }
  h1 { font-size: 1.6rem; margin: 0 0 8px; }
  .lede { color: var(--ink-muted); margin: 0 0 28px; }
  .back { margin-top: 20px; }
</style>
