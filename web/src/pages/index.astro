---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import { BUILD_META, CITY_PAGES } from '../lib/data';
import { websiteJsonLd } from '../lib/jsonld';

// docs/seo-policy.md §3: home is an "always potentially indexable" page
// type; docs/adr (Bloc C, page_publication) records it as such --
// PUBLIC_INDEXING_ENABLED being off still keeps this noindex in practice.
const website = websiteJsonLd();

// City display names, not raw ids ("new_york") -- BUILD_META.cities is
// exactly the 12 launch cities as of docs/adr/013 (fixed the Phase 2
// leftover that hardcoded "London and Bangkok" here after data.ts itself
// was fixed to import all 12 cities' static subsets).
const cityNames = BUILD_META.cities.map((id) => CITY_PAGES[id]?.city_name ?? id).sort();
---

<BaseLayout
  title="Understand a hotel's surroundings"
  description="Independent hotel-location intelligence: walkability, transit access, food & essentials, quiet-surroundings, family convenience, and nightlife access — computed from open geospatial data."
  indexable={true}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
  </Fragment>
  <section class="hero">
    <h1>Before you book, understand the surroundings.</h1>
    <p class="tagline">
      Computed scores for walkability, transit access, food &amp; essentials, quiet-surroundings,
      family convenience, and nightlife access — from open geospatial data, not reviews or prices.
    </p>
    <SearchBox />
    <p class="scope">
      Currently covering hotels in <strong>{cityNames.length} cities</strong>: {cityNames.join(', ')}
      (release {BUILD_META.release}).
    </p>
  </section>
</BaseLayout>

<style>
  .hero { padding: 40px 0 20px; }
  h1 { font-size: 1.9rem; margin: 0 0 12px; }
  .tagline { color: var(--ink-muted); margin: 0 0 28px; max-width: 60ch; }
  .scope { margin-top: 16px; color: var(--ink-muted); font-size: 0.9rem; }
</style>
