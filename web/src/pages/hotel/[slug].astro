---
// Result page. Order fixed by docs/strategy.md §2: identity -> verdict ->
// six scores -> persona selector -> why-facts -> map -> city comparison ->
// comparable hotels -> compare picker -> CTA -> methodology/confidence.
// ("Compare with another hotel" added here, right after the comparable-
// hotels list it naturally follows from -- docs/strategy.md §2 journey B.)
// `indexable` reads hotel.publication_status (docs/seo-policy.md §6,
// src/hotelareascore/publication.py -- a recorded decision, computed by
// scripts/compute_publication.py from the pilot cohort selection, never
// inferred here). BaseLayout still ANDs this with
// FLAGS.HOTEL_PAGE_INDEXING_ENABLED, which stays OFF (overnight mission
// Bloc C: "tout en flags OFF") -- so every hotel page renders noindex
// regardless of publication_status until that flag is deliberately
// turned on at Phase 4.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScoreDimensions from '../../components/ScoreDimensions.astro';
import NearbyFacts from '../../components/NearbyFacts.astro';
import MapSection from '../../components/MapSection.astro';
import CityComparison from '../../components/CityComparison.astro';
import ComparableHotels from '../../components/ComparableHotels.astro';
import ComparePicker from '../../components/ComparePicker.astro';
import CtaSection from '../../components/CtaSection.astro';
import { ALL_HOTELS, CITY_BASELINES } from '../../lib/data';
import { REASON_CODE_COPY } from '../../lib/reasonCodes';
import { breadcrumbJsonLd, lodgingBusinessJsonLd, placeJsonLd } from '../../lib/jsonld';

export function getStaticPaths() {
  return ALL_HOTELS.map((hotel) => ({
    params: { slug: hotel.slug },
    props: { hotel },
  }));
}

const { hotel } = Astro.props as { hotel: (typeof ALL_HOTELS)[number] };
const baseline = CITY_BASELINES[hotel.city_id];

const confidenceClass = hotel.confidence_label.toLowerCase();

// docs/seo-policy.md §6: Hotel/LodgingBusiness/Place/BreadcrumbList/WebSite
// only, never review/rating markup -- see lib/jsonld.ts's own guardrail
// comment. Emitted unconditionally (structured data on a noindex page is
// harmless and this is exactly the "prepared but inert" state Bloc C
// wants); it only ever matters once HOTEL_PAGE_INDEXING_ENABLED is on.
const breadcrumb = breadcrumbJsonLd([
  { name: 'Search', path: '/' },
  { name: hotel.city_name, path: `/city/${hotel.city_id}` },
  { name: (hotel.display_name ?? hotel.name), path: `/hotel/${hotel.slug}` },
]);
const place = placeJsonLd({ name: (hotel.display_name ?? hotel.name), lat: hotel.lat, lon: hotel.lon, addressLocality: hotel.locality });
const lodgingBusiness = lodgingBusinessJsonLd({
  name: (hotel.display_name ?? hotel.name),
  lat: hotel.lat,
  lon: hotel.lon,
  addressLocality: hotel.locality,
  url: `/hotel/${hotel.slug}`,
  balancedScore: hotel.balanced_score,
});
---

<BaseLayout
  title={`${(hotel.display_name ?? hotel.name)}${hotel.locality && hotel.locality !== (hotel.display_name ?? hotel.name) ? `, ${hotel.locality}` : ''} — surroundings score`}
  description={`${(hotel.display_name ?? hotel.name)} in ${hotel.city_name}: ${hotel.verdict}`}
  indexable={hotel.publication_status === 'indexable' && hotel.accommodation_type === 'hotel' && hotel.name_index_eligible === true}
  requiresFlag="HOTEL_PAGE_INDEXING_ENABLED"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(place)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(lodgingBusiness)} />
  </Fragment>
  <article class="hotel">
    <header class="identity">
      <p class="breadcrumb">
        {hotel.city_name}{hotel.locality && hotel.locality !== hotel.city_name ? ` · ${hotel.locality}` : ''}
        {hotel.far_from_center && (
          <span class="far-flag">
            · {hotel.distance_from_center_km} km from central {hotel.city_name}
          </span>
        )}
        {hotel.locality_mismatch && (
          <span class="far-flag">
            · {hotel.locality_mismatch_detail}
          </span>
        )}
      </p>
      <h1>{(hotel.display_name ?? hotel.name)}</h1>
      <p class="meta">{hotel.name_method === "transliteration_approximate" ? "Romanized name; spelling may differ." : ""}</p>
      <p class="meta">{hotel.accommodation_type_label ?? "Accommodation type unconfirmed"}</p>
      <p class="verdict">{hotel.verdict}</p>
      <div class="badges">
        <span class={`badge ${confidenceClass}`}>{hotel.confidence_label} confidence</span>
        <span class="balanced">Balanced score: <strong>{Math.round(hotel.balanced_score)}</strong>/100</span>
      </div>
      {
        hotel.reason_codes.length > 0 && (
          <ul class="reason-codes">
            {hotel.reason_codes.map((code) => (
              <li>{REASON_CODE_COPY[code] ?? code}</li>
            ))}
          </ul>
        )
      }
    </header>

    <ScoreDimensions scores={hotel.scores} />

    <NearbyFacts facts={hotel.nearby_facts} />

    <MapSection lat={hotel.lat} lon={hotel.lon} />

    {baseline && <CityComparison scores={hotel.scores} cityName={hotel.city_name} baseline={baseline} />}

    {hotel.comparable.length > 0 && (
      <ComparableHotels hotels={hotel.comparable} currentSlug={hotel.slug} cityId={hotel.city_id} />
    )}

    <ComparePicker currentSlug={hotel.slug} />

    <CtaSection />

    <section class="confidence-detail">
      <h2>Data &amp; confidence</h2>
      <p>
        Confidence: <strong>{hotel.confidence_label}</strong> ({hotel.confidence}/100).
        Score version <code>{hotel.score_version}</code>, from Overture Maps release{' '}
        <code>{hotel.source_release}</code>.
        {hotel.dedupe_confidence < 100 && (
          <> This hotel record was merged from multiple matching source entries.</>
        )}
        {' '}<a href="/methodology">Read the full methodology</a>.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .identity { padding-top: 24px; }
  .breadcrumb { color: var(--ink-muted); font-size: 0.85rem; margin: 0 0 6px; }
  .far-flag { color: #8a5a00; font-weight: 600; }
  h1 { margin: 0 0 10px; font-size: 1.7rem; }
  .verdict { font-size: 1.05rem; margin: 0 0 14px; }
  .badges { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; flex-wrap: wrap; }
  .balanced { color: var(--ink-muted); font-size: 0.92rem; }
  .reason-codes {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .reason-codes li {
    font-size: 0.82rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    color: var(--ink-muted);
  }
  .hotel > :global(section) { margin: 40px 0; }
  .hotel h2 { font-size: 1.15rem; }
  .confidence-detail { color: var(--ink-muted); font-size: 0.9rem; }
</style>
