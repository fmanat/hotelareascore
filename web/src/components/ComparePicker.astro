---
// A second hotel to compare against, picked from OUR index — same pattern
// as SearchBox (autocomplete on /data/search-index.json, no server, no
// external call). On selection, navigates to the Compare page
// (docs/strategy.md §2 journey B) rather than a hotel page. Keyboard nav /
// ARIA combobox / aria-live handled by ../lib/autocomplete.ts
// (docs/reports/phase-4-accessibility-audit.md finding 1).
interface Props {
  currentSlug: string;
}
const { currentSlug } = Astro.props;
---

<div class="compare-picker" data-current-slug={currentSlug}>
  <label for="compare-search" class="compare-label">Compare with another hotel</label>
  <input
    id="compare-search"
    type="search"
    placeholder="Search a hotel to compare…"
    autocomplete="off"
    aria-expanded="false"
    aria-controls="compare-picker-results"
  />
  <ul id="compare-picker-results" role="listbox" hidden></ul>
</div>

<style>
  .compare-picker { position: relative; margin: 24px 0; }
  .compare-label { display: block; font-weight: 600; margin-bottom: 8px; }
  input[type='search'] {
    width: 100%;
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }
  input[type='search']:focus { outline: 2px solid var(--accent); }
  ul#compare-picker-results {
    list-style: none;
    margin: 6px 0 0;
    padding: 4px;
    position: absolute;
    z-index: 10;
    width: 100%;
    max-height: 300px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  ul#compare-picker-results li[role='option'] {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    color: var(--ink);
    cursor: pointer;
  }
  ul#compare-picker-results li[role='option'].active {
    background: var(--bg);
  }
  ul#compare-picker-results .meta {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  ul#compare-picker-results .empty {
    padding: 10px 12px;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>

<script>
  import { setupAutocomplete } from '../lib/autocomplete';

  interface SearchIndexEntry {
    slug: string;
    name: string;
    city: string;
    locality: string | null;
  }

  document.querySelectorAll<HTMLElement>('.compare-picker').forEach((container) => {
    const currentSlug = container.dataset.currentSlug ?? '';
    const input = container.querySelector<HTMLInputElement>('#compare-search');
    const resultsEl = container.querySelector<HTMLUListElement>('#compare-picker-results');
    if (!input || !resultsEl) return;

    let index: SearchIndexEntry[] | null = null;
    let indexPromise: Promise<SearchIndexEntry[]> | null = null;

    function loadIndex(): Promise<SearchIndexEntry[]> {
      if (!indexPromise) {
        indexPromise = fetch('/data/search-index.json')
          .then((r) => r.json())
          .then((data: SearchIndexEntry[]) => {
            index = data;
            return data;
          });
      }
      return indexPromise;
    }

    setupAutocomplete<SearchIndexEntry>({
      input,
      resultsEl,
      containerEl: container,
      search: async (query) => {
        const data = index ?? (await loadIndex());
        return data
          .filter((e) => e.slug !== currentSlug && e.name.toLowerCase().includes(query))
          .slice(0, 8);
      },
      label: (e) => e.name,
      meta: (e) => (e.locality ? `${e.locality}, ${e.city}` : e.city),
      onSelect: (e) => {
        window.location.href = `/compare?a=${encodeURIComponent(currentSlug)}&b=${encodeURIComponent(e.slug)}`;
      },
      emptyMessage: 'No hotels found in our index.',
    });

    input.addEventListener('focus', () => loadIndex());
  });
</script>
