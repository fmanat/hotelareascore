---
// Autocomplete "on our index" (docs/strategy.md §2 journey A) — the index is
// /data/search-index.json (public/data, generated by webdata.py), fetched
// once client-side and filtered in the browser. No server, no external API.
// Keyboard nav / ARIA combobox / aria-live handled by ../lib/autocomplete.ts
// (docs/reports/phase-4-accessibility-audit.md finding 1).
---

<div class="search-box">
  <label for="hotel-search" class="visually-hidden">Search for a hotel</label>
  <input
    id="hotel-search"
    type="search"
    placeholder="Search a hotel…"
    autocomplete="off"
    aria-expanded="false"
    aria-controls="search-results"
  />
  <ul id="search-results" role="listbox" hidden></ul>
</div>

<style>
  .search-box { position: relative; }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  input[type='search'] {
    width: 100%;
    font-size: 1.05rem;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }
  input[type='search']:focus { outline: 2px solid var(--accent); }
  ul#search-results {
    list-style: none;
    margin: 6px 0 0;
    padding: 4px;
    position: absolute;
    z-index: 10;
    width: 100%;
    max-height: 340px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  ul#search-results li[role='option'] {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    color: var(--ink);
    cursor: pointer;
  }
  ul#search-results li[role='option'].active {
    background: var(--bg);
  }
  ul#search-results .meta {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  ul#search-results .empty {
    padding: 10px 12px;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>

<script>
  import { setupAutocomplete } from '../lib/autocomplete';
  import { recordSearchEvent } from '../lib/events';

  interface SearchIndexEntry {
    accommodation_type_label?: string;
    slug: string;
    name: string;
    city: string;
    city_id: string;
    locality: string | null;
    has_static_page: boolean;
  }

  const input = document.getElementById('hotel-search') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results') as HTMLUListElement | null;
  if (input && resultsEl) {
    let index: SearchIndexEntry[] | null = null;
    let indexPromise: Promise<SearchIndexEntry[]> | null = null;

    function loadIndex(): Promise<SearchIndexEntry[]> {
      if (!indexPromise) {
        indexPromise = fetch('/data/search-index.json')
          .then((r) => r.json())
          .then((data: SearchIndexEntry[]) => {
            index = data;
            return data;
          });
      }
      return indexPromise;
    }

    setupAutocomplete<SearchIndexEntry>({
      input,
      resultsEl,
      search: async (query) => {
        const data = index ?? (await loadIndex());
        const matches = data.filter((e) => e.name.toLowerCase().includes(query)).slice(0, 8);
        // docs/STATE.md "search_events as the coverage KPI" -- captured
        // here (this is THE search journey, docs/strategy.md journey A),
        // not the compare pickers. web/src/lib/events.ts: never sent
        // anywhere yet, ANALYTICS_ENABLED or not.
        recordSearchEvent(query, matches.length);
        return matches;
      },
      label: (e) => e.name,
      meta: (e) => `${e.accommodation_type_label ?? "Accommodation type unconfirmed"} · ${e.locality ? `${e.locality}, ${e.city}` : e.city}`,
      onSelect: (e) => {
        // docs/adr/013: the long tail outside the static-page budget has
        // no built `/hotel/{slug}` page -- route those to the
        // client-rendered limited-data card instead of a 404. `city`
        // lets that page fetch a small per-city index shard instead of
        // the full ~17 MB merged one (perf fix, see webdata.py).
        window.location.href = e.has_static_page
          ? `/hotel/${encodeURIComponent(e.slug)}`
          : `/hotel/limited?slug=${encodeURIComponent(e.slug)}&city=${encodeURIComponent(e.city_id)}`;
      },
      emptyMessage: 'No hotels found in our index.',
    });

    input.addEventListener('focus', () => loadIndex());
  }
</script>
