---
// Autocomplete "on our index" (docs/strategy.md §2 journey A) — the index is
// /data/search-index.json (public/data, generated by webdata.py), fetched
// once client-side and filtered in the browser. No server, no external API.
---

<div class="search-box">
  <label for="hotel-search" class="visually-hidden">Search for a hotel</label>
  <input
    id="hotel-search"
    type="search"
    placeholder="Search a hotel in London or Bangkok…"
    autocomplete="off"
    aria-expanded="false"
    aria-controls="search-results"
  />
  <ul id="search-results" role="listbox" hidden></ul>
</div>

<style>
  .search-box { position: relative; }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  input[type='search'] {
    width: 100%;
    font-size: 1.05rem;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }
  input[type='search']:focus { outline: 2px solid var(--accent); }
  ul#search-results {
    list-style: none;
    margin: 6px 0 0;
    padding: 4px;
    position: absolute;
    z-index: 10;
    width: 100%;
    max-height: 340px;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  ul#search-results li a {
    display: block;
    padding: 10px 12px;
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
  }
  ul#search-results li a:hover,
  ul#search-results li a:focus {
    background: var(--bg);
  }
  ul#search-results .meta {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
  ul#search-results .empty {
    padding: 10px 12px;
    color: var(--ink-muted);
    font-size: 0.9rem;
  }
</style>

<script>
  interface SearchIndexEntry {
    slug: string;
    name: string;
    city: string;
    locality: string | null;
  }

  const inputMaybe = document.getElementById('hotel-search') as HTMLInputElement | null;
  const resultsMaybe = document.getElementById('search-results') as HTMLUListElement | null;
  if (inputMaybe && resultsMaybe) {
    const input: HTMLInputElement = inputMaybe;
    const resultsEl: HTMLUListElement = resultsMaybe;
    let index: SearchIndexEntry[] | null = null;
    let indexPromise: Promise<SearchIndexEntry[]> | null = null;

    function loadIndex(): Promise<SearchIndexEntry[]> {
      if (!indexPromise) {
        indexPromise = fetch('/data/search-index.json')
          .then((r) => r.json())
          .then((data: SearchIndexEntry[]) => {
            index = data;
            return data;
          });
      }
      return indexPromise;
    }

    function slugifyForUrl(slug: string): string {
      return encodeURIComponent(slug);
    }

    function render(matches: SearchIndexEntry[], query: string) {
      resultsEl.innerHTML = '';
      if (query.length < 2) {
        resultsEl.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        return;
      }
      if (matches.length === 0) {
        resultsEl.innerHTML = '<li class="empty">No hotels found in our index.</li>';
        resultsEl.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        return;
      }
      const frag = document.createDocumentFragment();
      matches.slice(0, 8).forEach((m) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/hotel/${slugifyForUrl(m.slug)}`;
        a.innerHTML = `${m.name}<span class="meta">${m.locality ? m.locality + ', ' : ''}${m.city}</span>`;
        li.appendChild(a);
        frag.appendChild(li);
      });
      resultsEl.appendChild(frag);
      resultsEl.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    let debounceTimer: number | undefined;
    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(async () => {
        const data = index ?? (await loadIndex());
        const matches = query.length < 2 ? [] : data.filter((e) => e.name.toLowerCase().includes(query));
        render(matches, query);
      }, 120);
    });

    input.addEventListener('focus', () => {
      loadIndex();
    });

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Node)) return;
      if (!input.parentElement?.contains(e.target)) {
        resultsEl.hidden = true;
      }
    });
  }
</script>
