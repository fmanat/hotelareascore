---
import { FLAGS } from '../lib/flags';

interface Props {
  title: string;
  description: string;
  /** Only ever true when the relevant indexing flag is also on — see below. */
  indexable?: boolean;
}

const { title, description, indexable = false } = Astro.props;

// Indexability is a decision, never a side effect of a route existing
// (CLAUDE.md hard rule 2). Phase 2 has no page_publication table yet (that's
// Supabase serving-world, docs/adr/002) so the flags ARE the decision for
// now: both PUBLIC_INDEXING_ENABLED and the page's own request must be on,
// and both default off (docs/STATE.md — Phase 4 turns these on deliberately).
const robotsContent = FLAGS.PUBLIC_INDEXING_ENABLED && indexable ? 'index, follow' : 'noindex, nofollow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robotsContent} />
    <title>{title} · HotelAreaScore</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: light;
        --bg: #fbfaf8;
        --surface: #ffffff;
        --border: #e6e2da;
        --ink: #201d18;
        --ink-muted: #635c4f;
        --accent: #0f6e5c;
        --accent-ink: #ffffff;
        --warn: #a15c00;
        --low: #a13a2e;
        --radius: 10px;
        --max-width: 880px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        line-height: 1.5;
      }
      a { color: var(--accent); }
      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 20px 64px;
      }
      header.site {
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }
      header.site .inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 18px 20px;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
      }
      header.site .brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--ink);
        text-decoration: none;
      }
      header.site nav a {
        margin-left: 18px;
        color: var(--ink-muted);
        text-decoration: none;
        font-size: 0.92rem;
      }
      header.site nav a:hover { color: var(--accent); }
      footer.site {
        max-width: var(--max-width);
        margin: 48px auto 0;
        padding: 20px 20px 40px;
        border-top: 1px solid var(--border);
        color: var(--ink-muted);
        font-size: 0.85rem;
      }
      .badge {
        display: inline-block;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
      }
      .badge.high { background: #e3f3ec; color: var(--accent); }
      .badge.medium { background: #fbf0dc; color: var(--warn); }
      .badge.low { background: #f7e4e1; color: var(--low); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/">HotelAreaScore</a>
        <nav>
          <a href="/">Search</a>
          <a href="/methodology">Methodology</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <p>
        Scores are calculated automatically from geospatial data (Overture Maps). They
        describe the surrounding area, not hotel rooms or service quality.
        <a href="/methodology">Read the methodology</a>.
      </p>
      <p>Phase 2 product proof — not a public launch. Not affiliated with any hotel brand.</p>
    </footer>
  </body>
</html>
