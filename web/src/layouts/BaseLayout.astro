---
import { FLAGS } from '../lib/flags';
import { SITE_URL } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Only ever true when the page's own recorded publication_status is
   * 'indexable' (src/hotelareascore/publication.py) — see below. */
  indexable?: boolean;
  /** An additional, page-type-specific flag that must ALSO be on (e.g.
   * 'HOTEL_PAGE_INDEXING_ENABLED') — lets hotel pages stay off while
   * PUBLIC_INDEXING_ENABLED turns on for city/static pages, or vice versa. */
  requiresFlag?: keyof typeof FLAGS;
  /** Astro passes a markdown page's frontmatter here (nested), not spread
   * into top-level props, when this layout is used via `.md` frontmatter's
   * `layout:` field (the 4 legal pages) rather than an explicit
   * `<BaseLayout title=... />` call from a `.astro` page — fall back to it
   * below so both call conventions work identically. */
  frontmatter?: Partial<Props>;
}

const props = { ...Astro.props.frontmatter, ...Astro.props };
const { title, description, indexable = false, requiresFlag } = props;

// Indexability is a decision, never a side effect of a route existing
// (CLAUDE.md hard rule 2): `indexable` reflects a row in page_publication
// (docs/seo-policy.md §6) that some script explicitly wrote with a reason,
// never inferred here. That recorded decision is necessary but not
// sufficient — PUBLIC_INDEXING_ENABLED (and, for pages that pass
// `requiresFlag`, that flag too) must ALSO be on, and every flag defaults
// off (docs/STATE.md — Phase 4 turns these on deliberately).
const extraFlagOk = requiresFlag ? FLAGS[requiresFlag] : true;
const robotsContent =
  FLAGS.PUBLIC_INDEXING_ENABLED && extraFlagOk && indexable ? 'index, follow' : 'noindex, nofollow';

// docs/seo-policy.md §6: "One canonical hotel identity -> one canonical
// URL." Every page gets EXACTLY one canonical tag, computed here so no
// page template can accidentally omit one or emit two — strip any query
// string and a trailing slash (except the root) so ?a=&b= compare
// permutations and a stray trailing slash never count as a second URL for
// the same page.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(path, SITE_URL).toString();
const ogImageUrl = new URL('/og-default.svg', SITE_URL).toString();
const pageTitle = `${title} · StayContext`;

// Cloudflare Web Analytics (CLAUDE.md §5), night mission #3 Tache 4: only
// rendered when ANALYTICS_ENABLED is on AND a token is configured -- no
// Cloudflare Web Analytics site exists yet, so PUBLIC_CF_ANALYTICS_TOKEN
// is an empty placeholder in .env.example today, and the flag itself
// defaults off regardless. If this is ever turned on, the beacon script's
// origin (static.cloudflareinsights.com) also needs adding to
// web/public/_headers's script-src -- not done here since the flag is off.
const analyticsToken = (import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN as string | undefined) ?? '';
const showAnalytics = FLAGS.ANALYTICS_ENABLED && analyticsToken.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <!-- Open Graph / Twitter — a plain, on-brand default image
         (web/public/og-default.svg, "sobre" per the night mission order) so
         a shared link never renders with a blank/broken preview card. No
         per-page OG image variant yet; every page shares this one. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StayContext" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {showAnalytics && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
    <slot name="head" />
    <style>
      :root {
        color-scheme: light;
        --bg: #fbfaf8;
        --surface: #ffffff;
        --border: #e6e2da;
        --ink: #201d18;
        --ink-muted: #635c4f;
        --accent: #0f6e5c;
        --accent-ink: #ffffff;
        --warn: #a15c00;
        --low: #a13a2e;
        --radius: 10px;
        --max-width: 880px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        line-height: 1.5;
      }
      a { color: var(--accent); }
      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 20px 64px;
      }
      header.site {
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }
      header.site .inner {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 18px 20px;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
      }
      header.site .brand {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--ink);
        text-decoration: none;
      }
      header.site nav a {
        margin-left: 18px;
        color: var(--ink-muted);
        text-decoration: none;
        font-size: 0.92rem;
      }
      header.site nav a:hover { color: var(--accent); }
      footer.site {
        max-width: var(--max-width);
        margin: 48px auto 0;
        padding: 20px 20px 40px;
        border-top: 1px solid var(--border);
        color: var(--ink-muted);
        font-size: 0.85rem;
      }
      .badge {
        display: inline-block;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 600;
      }
      .badge.high { background: #e3f3ec; color: var(--accent); }
      .badge.medium { background: #fbf0dc; color: var(--warn); }
      .badge.low { background: #f7e4e1; color: var(--low); }
      /* Owner-provided legal templates (overnight mission Bloc C item 5) --
         visible on every one of the 4 legal pages until the owner reviews
         them; do not remove when editing their content, only when the
         owner has actually reviewed and approved the page. */
      .legal-links { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 14px; }
      .legal-links a { color: var(--ink-muted); }
    </style>
    <style is:global>
      /* NOT scoped like the block above: `.draft-banner` lives in the 4
         legal pages' markdown content, rendered into this layout's <slot />
         -- Astro's scoped-style attribute is only added to markup written
         directly in a component's own template, never to slotted content
         from the page using it, so a scoped rule here would silently never
         match. Keep this the one deliberate exception. */
      .draft-banner {
        background: #fbf0dc;
        color: var(--warn);
        border: 1px solid var(--warn);
        border-radius: var(--radius);
        padding: 10px 16px;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin: 20px 0;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/">StayContext</a>
        <nav>
          <a href="/">Search</a>
          <a href="/methodology">Methodology</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <p>
        Scores are calculated automatically from geospatial data (Overture Maps). They
        describe the surrounding area, not hotel rooms or service quality.
        <a href="/methodology">Read the methodology</a>.
      </p>
      <p>Phase 2 product proof — not a public launch. Not affiliated with any hotel brand.</p>
      <nav class="legal-links" aria-label="Legal">
        <a href="/legal-notice">Legal notice</a>
        <a href="/privacy">Privacy &amp; cookies</a>
        <a href="/affiliate-disclosure">Affiliate disclosure</a>
        <a href="/terms">Terms of use</a>
      </nav>
    </footer>
  </body>
</html>
